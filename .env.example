# KINETIC environment configuration template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and NEVER
# committed. All KINETIC settings can be overridden via environment variables
# with the `KINETIC_` prefix (see config/settings.py). Only commonly-used
# variables are listed here — the full set is documented in README.md /
# config/settings.py.
#
# Values shown are defaults/placeholders, NEVER real credentials.

# --- LLM / Claude Agent SDK ------------------------------------------------
# Required to run live agent model calls. Without it the CLI/web console exits
# with a clear error (no silent failure). Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: base URL / API proxy (forwarded to the SDK as ANTHROPIC_BASE_URL).
# KINETIC_LLM_BASE_URL=https://api.anthropic.com
# Optional: override the default model (config/settings.py default shown).
# KINETIC_MODEL=claude-sonnet-4-5-20250929

# --- Web console -----------------------------------------------------------
# The web console is OFF by default. Enable + bind to localhost for safety.
KINETIC_WEB_ENABLED=false
KINETIC_WEB_HOST=127.0.0.1
KINETIC_WEB_PORT=12000
# Seconds to poll for live SSE events (0 < t <= 60).
# KINETIC_WEB_EVENT_POLL_TIMEOUT=1.0
# Bounded per-task event ring size (1..10000).
# KINETIC_WEB_MAX_EVENT_LOG=512
# Interactive approval auto-deny timeout in seconds (1..3600).
# KINETIC_WEB_APPROVAL_TIMEOUT=300

# --- Docker runtime --------------------------------------------------------
# In sandboxes where the Docker socket is root-owned, sudo is required to talk
# to docker. Set to 1 to prefix docker invocations with sudo (explicit,
# environment-controlled — never a hidden privilege escalation).
KINETIC_DOCKER_SUDO=0
# Override the docker binary path if it is not on PATH.
# KINETIC_DOCKER_CMD=docker

# --- Sandbox / environment runtime -----------------------------------------
# KINETIC_RUNTIME_TYPE=local
# KINETIC_SANDBOX_MODE=false
# KINETIC_NETWORK_POLICY=deny
# KINETIC_CPU_LIMIT=
# KINETIC_MEMORY_LIMIT_MB=
# KINETIC_EXECUTION_TIMEOUT=600.0
# KINETIC_DOCKER_IMAGE=python:3.11-slim

# --- Task planning / repair ------------------------------------------------
# KINETIC_MAX_TURNS=40
# KINETIC_MAX_STEP_ATTEMPTS=2
# KINETIC_MAX_TASK_ATTEMPTS=3
# KINETIC_MAX_REPLANS=1
# KINETIC_ENABLE_REPAIR=false
# KINETIC_MAX_REPAIR_ATTEMPTS=2
# KINETIC_ENABLE_CHECKPOINTS=true
